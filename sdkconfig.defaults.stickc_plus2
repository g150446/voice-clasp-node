# M5StickC Plus2 (ESP32-PICO-V3-02)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="stickc_plus2/partitions_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="stickc_plus2/partitions_ota.csv"
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="HarnessNode-Plus2"
