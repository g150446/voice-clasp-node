/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Keep regulator-boot-on: the LSM6DSL driver must probe while the shared
 * IMU/microphone rail is powered. The power test may switch this rail off
 * after device initialization, then turn it back on for later states.
 */

/ {
	chosen {
		zephyr,console = &uart20;
	};
};

&uart20 {
	status = "okay";
};

&i2c30 {
	status = "okay";
};

&pdm20 {
	status = "okay";
};
